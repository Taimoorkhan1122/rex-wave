# Copy to $TMPDIR/rex-wave-<LABEL>.env, fill in, then:
# sh <this-skill-dir>/scripts/init-wave.sh <that file>  (path next to SKILL.md, absolute)
# Plain sh syntax: sourced by the scripts. Quote values that contain spaces.

LABEL=wave-login-fixes                       # run dir becomes $TMPDIR/rex-wave-$LABEL
REPO=/Users/you/git/my-repo                  # main checkout; agents only read it
BASE=main                                    # base ref for worktrees and diffs
WT_ROOT=/Users/you/git/my-repo-worktrees     # optional; defaults to $REPO-worktrees
TASKS="T310-quote T312-retell-optout"        # one per independent chunk; names [A-Za-z0-9-]
BUILDER_AGENT=commandcode                    # builder CLI allowlist: commandcode | claude | codex | opencode
BUILDER_MODEL=deepseek/deepseek-v4.1-flash   # model id as the chosen CLI expects it
REVIEW_AGENT=opencode                        # reviewer CLI allowlist: opencode | claude | codex | commandcode
REVIEW_MODEL=opencode/deepseek-v4.1-flash-free
COAUTHOR="Claude Opus 5.5 <noreply@anthropic.com>"   # trailer builders put on commits; set to your own line
TYPECHECK_CMD="npx tsc --noEmit -p tsconfig.app.json"
TEST_CMD='NODE_OPTIONS="--max-old-space-size=4096" npx vitest run --maxWorkers=2'
REVIEW_FOCUS="auth checks on every entry point, data exposure, injection, secrets in code or logs, destructive or non-idempotent migrations, broken callers"
